{
  "name": "تطبيق القرعة العشوائية الفاخر",
  "short_name": "القرعة العشوائية",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#f0f9ff",
  "theme_color": "#3b82f6",
  "orientation": "portrait-primary",
  "description": "تطبيق يساعدك على إجراء القرعة العشوائية بطريقة سهلة وجذابة",
  "categories": ["utilities", "entertainment"],
  "lang": "ar",
  "dir": "rtl",
  "icons": [
    {
      "src": "icons/lottery-icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "icons/lottery-icon-384.png",
      "type": "image/png",
      "sizes": "384x384"
    },
    {
      "src": "icons/lottery-icon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "icons/lottery-icon-1024.png",
      "type": "image/png",
      "sizes": "1024x1024"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/lottery-screenshot-1.png",
      "type": "image/png",
      "sizes": "1080x1920"
    },
    {
      "src": "screenshots/lottery-screenshot-2.png",
      "type": "image/png",
      "sizes": "1080x1920"
    }
  ],
  "splash_screens": [
    {
      "src": "splash/lottery-splash.png",
      "sizes": "2048x2732",
      "type": "image/png"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "shortcuts": [
    {
      "name": "بدء قرعة جديدة",
      "url": "/index.html?quickstart=true",
      "icons": [
        {
          "src": "icons/shortcut-new-lottery.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "إعدادات القرعة",
      "url": "/index.html?settings=open",
      "icons": [
        {
          "src": "icons/shortcut-settings.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "notification_preferences": {
    "vibrate": true,
    "sound": true,
    "alerts": ["winner_announcement", "lottery_results"]
  },
  "permissions": [
    "notifications",
    "storage"
  ],
  "serviceworker": {
    "src": "/lottery-sw.js",
    "scope": "/"
  },
  "install_prompt": {
    "title": "تثبيت تطبيق القرعة العشوائية",
    "description": "قم بتثبيت التطبيق للاستخدام دون اتصال بالإنترنت",
    "button_text": "تثبيت"
  },
  "update_preferences": {
    "auto_update": true,
    "update_interval": "weekly"
  },
  "offline_functionality": {
    "enabled": true,
    "cache_images": true,
    "cache_results": true
  },
  "custom_settings": {
    "default_winners_count": 1,
    "default_duration": 5,
    "default_winner_display_time": 8,
    "default_speed": 3,
    "enable_sound": true,
    "enable_vibration": true,
    "enable_confetti": true,
    "dark_mode": false,
    "language": "ar"
  }
}
